# ============================================================
# Soccer Blog Platform — Environment Variables
# Copy this file to .env.local and fill in your values.
# ============================================================

# Server-only — Payload CMS
PAYLOAD_API_URL=https://admin.vex-agency.com/api      # must end in /api
PAYLOAD_TENANT_SLUG=your-tenant-slug                  # scopes every read/write to this tenant
PAYLOAD_API_KEY=your-per-tenant-api-key               # required even for reads (tenant lookup is authenticated)
REVALIDATE_POSTS=3600
REVALIDATE_PAGES=86400
REVALIDATE_SECRET=your-random-secret-32-chars-minimum # must match this tenant's revalidateSecret in the CMS

# Favicon / icons — optional. Falls back to /favicon.ico when unset.
# Place tenant assets in public/<tenant-slug>/ and use relative paths.
# SITE_FAVICON_URL=/debate-cuervo/favicon.ico
# SITE_APPLE_TOUCH_ICON_URL=/debate-cuervo/apple-touch-icon.png
# SITE_ICON_192_URL=/debate-cuervo/favicon-192.png
# SITE_ICON_512_URL=/debate-cuervo/favicon-512.png

# White-label / per-team (NEXT_PUBLIC_ = browser-safe)
# These are the only values you need to change to fully rebrand the site for a new tenant.
NEXT_PUBLIC_SITE_NAME=Team Name News
NEXT_PUBLIC_SITE_URL=https://your-blog-domain.com
NEXT_PUBLIC_SITE_LOGO_URL=https://cdn.example.com/logo.svg
# Contact address shown on /contact and referenced from the legal pages. Required.
NEXT_PUBLIC_CONTACT_EMAIL=contacto@your-blog-domain.com

# Brand colors — quoted hex values (#RRGGBB). Unquoted # is a comment in .env files.
#
# PRIMARY_COLOR    → header bg, footer bg, primary buttons, category badges, post body headings
# SECONDARY_COLOR  → "Featured" accent bar, post body links, header bottom border
# PRIMARY_FOREGROUND → text color rendered ON TOP of primary-colored surfaces (usually #ffffff)
#
# The chain: env var → siteConfig.theme → layout.tsx <style> tag → CSS custom properties
# → shadcn's --primary token → Tailwind utilities (bg-primary, text-primary, etc.)
# Changing these vars recolors the entire UI without touching any component code.
NEXT_PUBLIC_PRIMARY_COLOR="#13294b"
NEXT_PUBLIC_SECONDARY_COLOR="#e4002b"
NEXT_PUBLIC_PRIMARY_FOREGROUND="#ffffff"

# Ads
NEXT_PUBLIC_AD_PROVIDER=adsense
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_SLOT_HEADER=
NEXT_PUBLIC_ADSENSE_SLOT_IN_CONTENT=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=
